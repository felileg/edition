						<gramGrp>
							<case value="genitive"/>
							<number value="singular"/>
						</gramGrp>
						<form type="determiner">
							<orth>des</orth>
						</form>
						<form type="headword">
							<orth>
								<oRef>Evangelii</oRef>
							</orth>
						</form>
					</form>
				</entry>	
