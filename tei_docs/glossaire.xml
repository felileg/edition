	<text>
		<body>
			<div1 type="alpha" xml:id="a" facs="facs/Jolidon_A1.png-001.png">
				<entry xml:id="ail" facs="facs/Jolidon_A1.png-003.png">

					<form>
						<form type="lemma" xml:lang="patois">ā</form>
						<gramGrp>
							<pos value="noun">s.</pos>
							<gen value="m">m.</gen>
						</gramGrp>
						<usg type="colloc" xml:lang="patois">l’ā</usg>
						<usg type="colloc" xml:lang="patois">lẹz_ā</usg>
					</form>

					<cit>
						<bibl>
							ALF, carte 17.
						</bibl>
					</cit>

					<sense>
						<def>Ail.</def>
						<note>On leur accorde une grande efficacité médicinale ; un sujet me disait :</note>
						<note type="example"> <q xml:lang="patois">S’ã sęvę kmã lẹz ā sõ bõ, ãn ã pyẽtrę ĩ kẽto</q> <supplied cert="high">(si on savait comme les ails sont bons, on en planterait un canton).</supplied></note>
					</sense>
				</entry>
				<entry xml:id="haut-e" facs="facs/Jolidon_A1.png-004.png">
					<form>
						<form type="lemma" xml:lang="patois">ā</form>,
						<form type="lemma" xml:lang="patois">āt</form>
						<gramGrp>
							<pos value="adjective">adj.</pos>
						</gramGrp>
					</form>

					<etym xml:lang="lat">&gt; altu, -a</etym>
					<sense>
						<def>
							Haut, haute.
						</def>
						<note type="example">
							<q xml:lang="patois">Par tro ā (tro bẹ), sꭒ̯ayīᵊ ā</q> : <supplied cert="high">"prendre trop haut" (ou trop bas), "faucher haut"</supplied> : <supplied cert="medium">faucher trop haut (ou trop bas)</supplied>.
						</note>
						<note type="example">
							<q xml:lang="patois">Āt dė kꭒₔ</q> : "haute de queue", se dit d’une vache dont la racine de la queue est trop élevée.
						</note>
						<note type="example">
							<q xml:lang="patois">Lə a mā</q> : le haut mal, le mal caduc (<supplied cert="high">épilepsie)</supplied>.
						</note>
						<note type="example">
							<q xml:lang="patois">Lę tšẽbr a</q> : "la chambre haute", chambre située au premier étage.
						</note>
						<note type="example">
							<q xml:lang="patois">S’ā dẹ džã ā pyęsīₔ</q> : "c'est des gens haut placés", qui jouissent d'une situation supérieure, financière ou autre.
						</note>
						<note type="example">
							<q xml:lang="patois">Lę āt ętšăt</q> : <supplied cert="high">"la haute abeille"</supplied>, <supplied cert="low">la reine</supplied>
						</note>
						<note type="example">
							<q xml:lang="patois">Fęr dẹ ā džęvẹ</q> : <supplied cert="medium">"faire des hautes javelles"</supplied>, <supplied cert="unknown">?</supplied>
						</note>
						<note type="example">
							<q xml:lang="patois">Lę at grẽdž</q> : <supplied cert="high">"la haute grange"</supplied>,
							<supplied cert="high">
								<cit>
									<q>Grange dont l’aire est au niveau des fenils, plus haut que les étables, avec entrée par l’arrière de la maison au moyen d’un plan incliné</q> <bibl>(GPSR, article "grange").</bibl>
								</cit>
							</supplied>
						</note>
						<note type="example">
							<q xml:lang="patois"><unclear cert="medium">F</unclear>ãdu ā</q> : <supplied cert="medium">"fendu haut"</supplied>, se dit de quelqu'un qui est haut sur jambes.
						</note>
					</sense>
				</entry>
				<entry xml:id="hauts" facs="facs/Jolidon_A1.png-002.png">
					<form>
						<form type="lemma" xml:lang="patois">
							ā
						</form>
						<gramGrp>
							<pos value="noun">s.</pos>
							<gen value="m">m.</gen>
							<number value="plural"/>
							<usg type="colloc" xml:lang="patois">lẹ ā</usg>
							<usg>Ne s'emploie qu'au pluriel</usg>
						</gramGrp>
					</form>
					<sense>
						<def>"Les hauts"</def>
						<note>
							S'emploie en opposition à <q xml:lang="patois">lẹ bẹ</q> ("les bas") et désigne la montagne par opposition à la vallée, les hauteurs de la montagne.
						</note>
					</sense>
				</entry>
				<entry xml:id="bénitier" facs="facs/Jolidon_A1.png-006.png">
					<form>
						<form type="lemma" xml:lang="patois">abnīₑ̇</form>
						<gramGrp>
							<pos value="noun">s.</pos>
							<gen value="f">m.</gen>
							<usg type="colloc" xml:lang="patois">ĩn abnīₑ̇</usg>
						</gramGrp>
						<form type="variant" xml:lang="patois">abnẹtīₔ</form>
					</form>
					<sense>
						<def>Bénitier.</def>
						<note type="comment">"Eau-bénitier".</note>
					</sense>
				</entry>
				<entry xml:id="eau-bénite" facs="facs/Jolidon_A1.png-007.png">
					<form>
						<form type="lemma" xml:lang="patois">abnīₑ̇</form>
						<gramGrp>
							<pos value="noun">s.</pos>
							<gen value="f">f.</gen>
							<usg type="colloc">l'abnīₑ̇</usg>
						</gramGrp>
					</form>
					<cit>
						<bibl>
							ALF, carte 125
						</bibl>
					</cit>
					<sense>
						<def>Eau bénite.</def>
						<note type="example">
							<q xml:lang="patois">Ęprẹ l’abniₔ</q> : après l'aspergès.
						</note>
						<note type="example">
							<q xml:lang="patois">Tšẽpę̄ d l’abniₔ</q> : <supplied>jeter de l'eau bénite.</supplied>
						</note>
						<gap reason="editorial"/>
					</sense>
				</entry>
			</div1>
		</body>
	</text>
